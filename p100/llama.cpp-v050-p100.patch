+void ggml_cuda_tune_refresh() {
+    static bool   env_done = false;
+    static double last_check = 0.0;
+    static long long last_mtime = -1;
+    if (!env_done) {
+        env_done = true;
+        static const std::pair<const char *, const char *> env_keys[] = {
+            {"GGML_CUDA_AR_PASCAL", "AR"}, {"GGML_CUDA_AR_BF16_THRESHOLD", "AR_BF16"},
+            {"GGML_CUDA_GRAPHS_PASCAL", "GRAPHS"}, {"GGML_CUDA_MMVQ_PASCAL_CFG", "MMVQ"},
+            {"GGML_CUDA_MMVH_PASCAL", "MMVH"}, {"GGML_CUDA_MMVH_IQ4", "MMVH_IQ4"}, {"GGML_CUDA_MMVH_FUSE", "MMVH_FUSE"},
+            {"GGML_CUDA_MMVH_MC", "MMVH_MC"}, {"GGML_CUDA_FA_GQA_PAD", "FA_GQA_PAD"},
+            {"GGML_CUDA_MMVH_IQ4_MC", "MMVH_IQ4_MC"},
+            {"GGML_CUDA_MMVH_MC_Q6", "MMVH_MC_Q6"},
+            {"GGML_CUDA_MMVQ_ID_PASCAL", "MMVQ_ID"}, {"GGML_CUDA_MMVF_SHORTK_PASCAL", "MMVF_SHORTK"}, // 2026-10-17
+        };
+        for (const auto & kv : env_keys) {
+            if (const char * v = getenv(kv.first)) {
+                ggml_cuda_tune_apply(kv.second, v);
+            }
+        }
+    }
+    const char * path = getenv("GGML_CUDA_TUNE_FILE");
+    if (path == nullptr) {
+        return;
+    }
+    const double now = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    if (now - last_check < 0.2) {
+        return;
+    }
+    last_check = now;
+    struct stat st;
+    if (stat(path, &st) != 0 || (long long) st.st_mtim.tv_sec * 1000000000LL + st.st_mtim.tv_nsec == last_mtime) {
+        return;
+    }
+    last_mtime = (long long) st.st_mtim.tv_sec * 1000000000LL + st.st_mtim.tv_nsec;
+    FILE * f = fopen(path, "r");
+    if (f == nullptr) {
+        return;
+    }
+    char line[256];
+    while (fgets(line, sizeof(line), f)) {
+        char * eq = strchr(line, '=');
+        if (eq == nullptr) {
+            continue;
+        }
+        *eq = 0;
+        char * nl = strpbrk(eq + 1, "\r\n");
+        if (nl) {
+            *nl = 0;
+        }
+        ggml_cuda_tune_apply(line, eq + 1);
+    }
+    fclose(f);
+    GGML_LOG_INFO("%s: AR=%d AR_BF16=%d GRAPHS=%d MMVQ=%d,%d MMVH=%d\n", __func__, ggml_cuda_tune.ar, ggml_cuda_tune.ar_bf16,
+                  ggml_cuda_tune.graphs, ggml_cuda_tune.mmvq_s, ggml_cuda_tune.mmvq_l, ggml_cuda_tune.mmvh);
+}
